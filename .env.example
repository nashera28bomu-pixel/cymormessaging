# =========================================================
# CYMOR MESSAGING - ENVIRONMENT VARIABLES
# Copy this file to .env in /backend and /worker and fill in real values.
# NEVER commit a real .env file.
# =========================================================

# --- Application ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000/api/v1

# --- MongoDB Atlas ---
# Get this from MongoDB Atlas > Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cymor_messaging

# --- Authentication ---
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Meta / WhatsApp Business Platform ---
# Values below are the current standard Cloud API + Embedded Signup credentials
# as of Meta's official documentation. Verify against developers.facebook.com
# before going to production, since Meta updates these periodically.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v20.0
META_VERIFY_TOKEN=choose_a_random_string_you_define_yourself
META_SYSTEM_USER_ACCESS_TOKEN=
# Required only if using Embedded Signup (recommended onboarding flow):
META_CONFIGURATION_ID=
# Per-connection values below are NOT set here - they are stored per
# WhatsAppAccount document in MongoDB once a business completes onboarding:
#   WHATSAPP_BUSINESS_ACCOUNT_ID (WABA ID)
#   WHATSAPP_PHONE_NUMBER_ID
#   Per-account access token (encrypted at rest)

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (queues, rate limiting, realtime pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Email (verification, password reset, invitations) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Cymor Messaging <no-reply@cymormessaging.com>"

# --- Encryption ---
# Used to encrypt WhatsApp access tokens and other sensitive fields at rest
CREDENTIALS_ENCRYPTION_KEY=replace_with_a_32_byte_random_key
